# ============================================
# Environment Variables Sample
# ============================================
# این فایل فقط برای نمونه است.
# برای استفاده، یک کپی از این فایل با نام .env.local بسازید
# و مقادیر واقعی را جایگزین کنید.
# ============================================

# ============================================
# Database - محیط توسعه (SQLite)
# ============================================
DATABASE_URL="file:./prisma/dev.db"

# ============================================
# Database - محیط تولید (PostgreSQL/Neon)
# ============================================
# برای دپلوی روی Vercel با Neon، از این استفاده کن:
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
# 
# راهنمای دریافت از Neon:
# 1. وارد Neon Dashboard شو
# 2. روی Connection Details کلیک کن
# 3. گزینه Pooled Connection رو انتخاب کن
# 4. رشته رو کپی کن و اینجا بذار

# ============================================
# NextAuth.js - احراز هویت
# ============================================
# رمز برای احراز هویت (حداقل 32 کاراکتر)
# برای تولید یک رمز قوی:
# - در Mac/Linux: openssl rand -base64 32
# - در Windows: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-secret-key-here"

# آدرس پایه برنامه
# - برای توسعه محلی: http://localhost:4000
# - برای تولید (Vercel): https://[اسم-پروژه].vercel.app
NEXTAUTH_URL="http://localhost:4000"

# ============================================
# محیط اجرا (فقط برای تولید)
# ============================================
# NODE_ENV="production"

# ============================================
# توضیحات کامل متغیرها
# ============================================
# DATABASE_URL    - آدرس اتصال به دیتابیس
#                   - محلی: file:./prisma/dev.db
#                   - تولید: postgresql://...
#
# NEXTAUTH_SECRET - رمز برای احراز هویت
#                   - حداقل 32 کاراکتر
#                   - برای تولید حتماً یک رمز قوی بساز
#
# NEXTAUTH_URL    - آدرس پایه برنامه
#                   - محلی: http://localhost:4000
#                   - تولید: https://my-app.vercel.app
#
# NODE_ENV        - محیط اجرا (development/production)
#                   - فقط برای تولید لازمه

# ============================================
# فایل‌های محیطی در این پروژه
# ============================================
# .env.local      - برای توسعه محلی (SQLite)
# .env.production - برای تولید (Neon) - به Git نزن!
# .env.example    - این فایل (نمونه برای تیم)
#
# ⚠️ توجه: فایل‌های .env.* رو به Git نزنید!
# فقط .env.example رو به Git بزنید.
# ============================================